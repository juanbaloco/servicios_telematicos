// Configuracion de auditoria - Servicios Telematicos UAO
logging {

    channel canal_queries {
        file "/var/log/named/queries.log" versions 3 size 5m;
        severity info;
        print-time yes;
        print-category yes;
        print-severity yes;
    };

    channel canal_transfers {
        file "/var/log/named/transfers.log" versions 3 size 5m;
        severity info;
        print-time yes;
        print-category yes;
        print-severity yes;
    };

    channel canal_security {
        file "/var/log/named/security.log" versions 3 size 5m;
        severity info;
        print-time yes;
        print-category yes;
        print-severity yes;
    };

    category queries        { canal_queries; };
    category xfer-in        { canal_transfers; };
    category xfer-out       { canal_transfers; };
    category notify         { canal_transfers; };
    category security       { canal_security; };
    category rate-limit     { canal_security; };
};
