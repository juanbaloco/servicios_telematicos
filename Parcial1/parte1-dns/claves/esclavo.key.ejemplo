// Clave TSIG compartida entre maestro y esclavo
// Servicios Telematicos - UAO
//
// EL SECRETO REAL NO SE PUBLICA. Para regenerar la clave:
//     sudo tsig-keygen -a HMAC-SHA256 esclavo-key
//
// El archivo resultante debe guardarse en /etc/bind/keys/esclavo.key
// en AMBOS servidores, con el MISMO valor de secret, y con permisos:
//     sudo chown root:bind /etc/bind/keys/esclavo.key
//     sudo chmod 640 /etc/bind/keys/esclavo.key

key "esclavo-key" {
        algorithm hmac-sha256;
        secret "<<< REDACTADO - generar con tsig-keygen >>>";
};
